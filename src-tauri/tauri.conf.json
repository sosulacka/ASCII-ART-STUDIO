{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "asciiartstudio",
  "version": "0.1.0",
  "identifier": "com.ascii.artstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ASCII Art Studio",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#0a0a0b",
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "resources": {
      "assets/*": "assets/",
      "resources/vcam/softcam64.dll": "vcam/softcam64.dll",
      "resources/vcam/softcam32.dll": "vcam/softcam32.dll",
      "resources/vcam/softcam-LICENSE.txt": "vcam/softcam-LICENSE.txt",
      "../licenses/**/*": "licenses/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "libv4l-0"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}